---
// Riso-print K: an ink plate and a blue plate printed slightly off register,
// with pink scraps scattered around it (kalat = mess, kumalat = spread).
// Colors come from tokens so it follows light/dark mode.
interface Props {
  size?: number;
}
const { size = 36 } = Astro.props;
---

<svg
  class="logo"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <g class="plate-blue" transform="translate(3 2.5)">
    <path d="M12 9h12v46H12z" />
    <path d="M24 31 41 9h14L32 38z" />
    <path d="M30 33l8-7 18 29H42z" />
  </g>
  <g class="plate-ink">
    <path d="M12 9h12v46H12z" />
    <path d="M24 31 41 9h14L32 38z" />
    <path d="M30 33l8-7 18 29H42z" />
  </g>
  <g class="scraps">
    <path d="M50 22l7-2 1 6-6 2z" />
    <path d="M4 48l5 3-4 4z" />
    <circle cx="58" cy="42" r="2.6" />
    <path d="M38 52l4 1-1 3-4-1z" />
  </g>
</svg>

<style>
  .logo {
    display: block;
    flex: none;
    overflow: visible;
  }
  .plate-blue {
    fill: var(--color-riso-blue);
  }
  .plate-ink {
    fill: var(--color-ink);
    mix-blend-mode: multiply;
  }
  .scraps {
    fill: var(--color-accent);
  }
  @media (prefers-color-scheme: dark) {
    .plate-ink {
      mix-blend-mode: normal;
    }
  }
</style>
